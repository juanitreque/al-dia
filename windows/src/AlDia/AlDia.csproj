<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlDia</AssemblyName>
    <RootNamespace>AlDia</RootNamespace>
    <Product>Al Día</Product>
    <Version>0.1.0</Version>
    <Company>juanitreque</Company>
    <Copyright>© 2026 juanitreque · GPL-3.0-or-later</Copyright>
    <ApplicationIcon>Recursos/AlDia.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Recursos/**" Exclude="Recursos/Fuentes/**" />
    <!-- Lato (SIL OFL 1.1) para la factura en PDF; PDFsharp incrusta solo las letras usadas. -->
    <EmbeddedResource Include="Recursos/Fuentes/*.ttf" LogicalName="AlDia.Fuentes.%(Filename)%(Extension)" />
    <None Include="Recursos/Fuentes/OFL.txt" Link="Licencias/Lato-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- 6.2.4 es la última versión MIT: desde la 6.5.0 PDFsharp se publica con AGPL. No actualizar sin revisar la licencia. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AlDia.Core/AlDia.Core.csproj" />
  </ItemGroup>

</Project>
